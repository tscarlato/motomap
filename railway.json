{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "nixpacksConfig": {
        "phases": {
          "install": {
            "cmds": ["npm install"]
          },
          "build": {
            "cmds": ["npm run build"]
          }
        }
      }
    },
    "deploy": {
      "numReplicas": 1,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "startCommand": "npm run serve"
    }
  }